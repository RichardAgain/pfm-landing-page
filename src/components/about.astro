---
import type { ImageMetadata } from "astro";
import PhotoTile from "@components/grids/photo-tile.astro";

import grid1 from "@assets/about/grid1.JPG";
import grid2 from "@assets/about/grid2.JPG";
import grid3 from "@assets/about/grid3.JPG";
import grid4 from "@assets/about/grid4.JPG";
import grid5 from "@assets/about/grid5.JPG";
import grid6 from "@assets/about/grid6.JPG";
import grid7 from "@assets/about/grid7.JPG";

const stats: { value: number; suffix: string; label: string }[] = [
	{ value: 500, suffix: "+", label: "Estudiantes" },
	{ value: 30, suffix: "+", label: "Cátedras" },
	{ value: 50, suffix: "+", label: "Años de historia" },
];

// Wide tiles span two of the three mosaic columns
const gridImages: { src: ImageMetadata; alt: string; wide?: boolean }[] = [
	{ src: grid1, alt: "Dos integrantes de la academia tocan instrumentos de cuerda frente a un atril", wide: true },
	{ src: grid2, alt: "Un estudiante y una integrante de la academia tocan instrumentos de viento de pie" },
	{ src: grid3, alt: "Estudiante toca tambores junto a sus compañeros" },
	{ src: grid7, alt: "Estudiante muy joven toca el violín en medio de la orquesta" },
	{ src: grid4, alt: "Estudiantes tocan violonchelo durante un concierto de la orquesta" },
	{ src: grid6, alt: "Estudiante concentrada toca el violín en un acto" },
	{ src: grid5, alt: "Estudiante toca el violín en un concierto, con el coro de fondo", wide: true },
];
---

<section
	id="nosotros"
	class="grid md:grid-cols-2 w-full bg-gradient-to-b from-wine-deep to-wine border-t-6 border-white"
>
	<div
		data-reveal="left"
		class="flex flex-col justify-center gap-6 px-[7.5vw] md:px-10 lg:px-16 py-12 md:py-16 font-montserrat text-white opacity-0"
	>
		<div class="flex flex-col gap-3">
			<h2 class="text-4xl lg:text-5xl leading-tight text-balance">
				El <b>semillero</b> de la <b>Orquesta Sinfónica de Carabobo</b>
			</h2>
			<p class="text-lg lg:text-xl font-light italic text-pretty">
				Un legado de cultura, tradición y pasión por la música sinfónica
			</p>
		</div>

		<span aria-hidden="true" class="block w-12 h-0.5 bg-gold-trim"></span>

		<ul class="grid grid-cols-[auto_auto_minmax(0,1fr)] sm:grid-cols-3 gap-4">
			{
				stats.map(({ value, suffix, label }) => (
					<li class="flex flex-col gap-1">
						<span class="sr-only">{`${value}${suffix}`}</span>
						<span
							aria-hidden="true"
							class="text-3xl lg:text-5xl font-bold tabular-nums"
							data-counter-target={value}
							data-counter-suffix={suffix}
						>
							{`${value}${suffix}`}
						</span>
						<span class="text-sm lg:text-base leading-snug">{label}</span>
					</li>
				))
			}
		</ul>

		<a
			href="/catedras"
			class="w-fit px-6 py-3 text-base lg:text-lg font-bold text-wine-deep bg-gold-trim hover:bg-white rounded-full transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
		>
			Conoce nuestras cátedras
		</a>
	</div>

	<div
		data-reveal="right"
		class="grid grid-cols-3 grid-rows-[repeat(3,minmax(7.5rem,1fr))] md:grid-rows-[repeat(3,minmax(13.75rem,1fr))] 2xl:grid-rows-[repeat(3,minmax(16rem,1fr))] gap-0.5 bg-white border-t-2 md:border-t-0 md:border-l-2 border-white opacity-0"
	>
		{
			gridImages.map(({ src, alt, wide }) => (
				<PhotoTile src={src} alt={alt} class:list={{ "col-span-2": wide }} />
			))
		}
	</div>
</section>

<script src="../scripts/reveal.ts"></script>
