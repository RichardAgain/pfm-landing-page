---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

import iconViolin from "@assets/about/image1.png";
import iconNote from "@assets/about/image2.png";
import iconHourglass from "@assets/about/image3.png";

import grid1 from "@assets/about/grid1.JPG";
import grid2 from "@assets/about/grid2.JPG";
import grid3 from "@assets/about/grid3.JPG";
import grid4 from "@assets/about/grid4.JPG";
import grid5 from "@assets/about/grid5.JPG";
import grid6 from "@assets/about/grid6.JPG";
import grid7 from "@assets/about/grid7.JPG";

const stats: { icon: ImageMetadata; value: number; suffix: string; label: string }[] = [
	{ icon: iconViolin, value: 500, suffix: "+", label: "Estudiantes" },
	{ icon: iconNote, value: 30, suffix: "+", label: "Cátedras" },
	{ icon: iconHourglass, value: 50, suffix: "+", label: "Años de historia" },
];

// Wide tiles span two of the three mosaic columns
const gridImages: { src: ImageMetadata; wide?: boolean }[] = [
	{ src: grid1, wide: true },
	{ src: grid2 },
	{ src: grid3 },
	{ src: grid7 },
	{ src: grid4 },
	{ src: grid6 },
	{ src: grid5, wide: true },
];

const objectives = [
	"Formar a niños(as) para ser los futuros miembros de la OSC, desde un enfoque de la educación musical integral que enfatiza la iniciación en la práctica instrumental individual y grupal desde edades muy tempranas.",
	"Proporcionar a los miembros de la Academia, la oportunidad de descubrir sus capacidades interpretativas en una formación orquestal, permitiéndoles desarrollarse como músicos profesionales potencialmente exitosos.",
	"Desarrollar un programa educativo musical que contemple contenidos complementarios y en valores que contribuyan a la formación integral de los niños, niñas y adolescentes participantes.",
];
---

<section id="nosotros" class="flex flex-col w-full">
	<!-- Trayectoria: stats band -->
	<section
		data-animate-top
		class="relative w-full min-h-110 py-12 md:py-36"
	>
		<div
			class="absolute inset-0 z-0 w-full bg-gradient-to-b from-wine-deep to-wine border-y-6 border-white"
		>
		</div>

		<div
			data-animate-top-target
			class="relative z-5 flex flex-col w-[85vw] gap-8 mx-auto opacity-0"
		>
			<div class="flex flex-col gap-4">
				<h2
					class="text-4xl md:text-5xl font-montserrat text-white font-bold text-center text-balance"
				>
					Nuestra trayectoria
				</h2>
				<p
					class="text-lg md:text-xl font-montserrat text-white font-light italic text-center text-balance"
				>
					Un legado de cultura, tradición y pasión por la música
					sinfónica
				</p>
			</div>

			<ul class="grid md:grid-cols-3 items-center justify-center gap-y-8">
				{
					stats.map(({ icon, value, suffix, label }) => (
						<li class="flex flex-col items-center gap-2 md:gap-4">
							<Picture
								src={icon}
								formats={["webp"]}
								alt=""
								class="w-35 md:w-60 h-35 md:h-60 object-cover"
							/>
							<p class="flex flex-col justify-center items-center md:gap-1 font-montserrat text-white">
								<span class="sr-only">{`${value}${suffix}`}</span>
								<span
									aria-hidden="true"
									class="text-4xl md:text-5xl font-bold tabular-nums"
									data-counter-target={value}
									data-counter-suffix={suffix}
								>
									{`${value}${suffix}`}
								</span>
								<span class="text-xl md:text-2xl font-normal">
									{label}
								</span>
							</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class="flex justify-center mt-12 relative z-10">
			<a
				href="/catedras"
				class="inline-block px-8 py-4 text-xl md:text-2xl font-montserrat text-white font-bold bg-bronze hover:bg-bronze-deep rounded-full transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
			>
				Conoce nuestras cátedras
			</a>
		</div>
	</section>

	<!-- Statement + photo mosaic -->
	<section class="relative w-full min-h-300 md:min-h-screen">
		<div class="absolute inset-0 z-0 w-full grid md:grid-cols-2">
			<div
				data-animate-left
				class="flex w-full bg-gradient-to-b from-bronze to-gold-trim px-12 md:px-28 border-b-6 md:border-b-0 md:border-r-6 border-white items-center opacity-0"
			>
				<h2
					class="text-5xl md:text-7xl font-montserrat text-white text-center md:text-left text-balance"
				>
					El <b>hogar</b> de los <b>músicos</b> del <b>mañana</b>
				</h2>
			</div>

			<div
				data-animate-right
				class="w-full grid grid-cols-3 gap-1 opacity-0"
			>
				{
					gridImages.map(({ src, wide }) => (
						<div
							class:list={[
								"relative w-full h-full md:h-[33.3vh]",
								{ "col-span-2": wide },
							]}
						>
							<Picture
								src={src}
								formats={["webp"]}
								alt=""
								class="w-full h-full object-cover"
							/>
							<div class="absolute inset-0 bg-black opacity-30 z-10 pointer-events-none" />
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Misión -->
	<section
		data-animate-values
		class="relative w-full min-h-110 py-24 md:py-42"
	>
		<div
			class="absolute inset-0 z-0 w-full bg-gradient-to-b from-wine-deep to-wine border-y-6 border-white"
		>
		</div>

		<div
			data-animate-values-target
			class="relative z-10 flex flex-col w-[85vw] gap-16 md:gap-20 mx-auto opacity-0"
		>
			<div class="flex flex-col gap-8">
				<h2
					class="text-4xl md:text-5xl font-montserrat text-white font-bold text-center text-balance"
				>
					Nuestra misión
				</h2>
				<p
					class="max-w-[68ch] mx-auto md:text-xl md:leading-relaxed font-montserrat text-white font-light text-center text-pretty"
				>
					Ejecutar una propuesta educativa integral en el campo de la
					formación musical dentro de la OSC, que contemple los
					niveles inicial, medio y avanzado, impartida con altos
					niveles de calidad y creatividad dentro de un clima de
					enseñanza-aprendizaje que permita potenciar de manera
					gradual las actitudes y aptitudes de niños(as) y
					adolescentes ante la música y su ejecución instrumental, con
					vistas a prepararlos para su incorporación a los estudios
					del nivel profesional o universitario.
				</p>
			</div>

			<ul class="grid md:grid-cols-3 gap-12 md:gap-16">
				{
					objectives.map((text) => (
						<li class="flex flex-col items-center gap-5">
							<span
								aria-hidden="true"
								class="block w-12 h-0.5 rounded-full bg-gold-trim"
							/>
							<p class="max-w-[38ch] font-montserrat text-white font-medium leading-relaxed text-center text-pretty">
								{text}
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<script>
		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		// Reveal an element once it enters the viewport. With reduced motion
		// it simply appears, without the slide.
		function revealOnView(
			trigger: Element | null,
			target: Element | null,
			animationClass: string,
			threshold: number,
			onReveal?: () => void,
		) {
			if (!trigger || !target) return;
			const obs = new IntersectionObserver(
				([entry]) => {
					if (!entry.isIntersecting) return;
					target.classList.remove("opacity-0");
					if (!reduceMotion) target.classList.add(animationClass);
					onReveal?.();
					obs.disconnect();
				},
				{ threshold },
			);
			obs.observe(trigger);
		}

		// Count a stat up from 0. The real value is already in the markup (and
		// in an sr-only copy), so no-JS, reduced-motion and screen-reader users
		// always get the final number.
		function startCounter(el: HTMLElement, duration = 2000) {
			const target = Number(el.dataset.counterTarget || "0");
			const suffix = el.dataset.counterSuffix || "";
			const startTime = performance.now();
			function tick(now: number) {
				const progress = Math.min((now - startTime) / duration, 1);
				// ease-out so the count settles instead of stopping abruptly
				const eased = 1 - Math.pow(1 - progress, 3);
				el.textContent =
					Math.floor(target * eased).toLocaleString() + suffix;
				if (progress < 1) requestAnimationFrame(tick);
			}
			requestAnimationFrame(tick);
		}

		const top = document.querySelector("[data-animate-top]");
		revealOnView(
			top,
			document.querySelector("[data-animate-top-target]"),
			"slide-from-bottom",
			0.1,
			() => {
				if (reduceMotion || !top) return;
				top.querySelectorAll<HTMLElement>(
					"[data-counter-target]",
				).forEach((el) => startCounter(el));
			},
		);

		const left = document.querySelector("[data-animate-left]");
		revealOnView(left, left, "slide-from-left", 0.1);

		const right = document.querySelector("[data-animate-right]");
		revealOnView(right, right, "slide-from-right", 0.1);

		revealOnView(
			document.querySelector("[data-animate-values]"),
			document.querySelector("[data-animate-values-target]"),
			"slide-from-bottom",
			0.2,
		);
	</script>
</section>
