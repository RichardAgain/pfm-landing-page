---
import { FaWhatsapp } from "react-icons/fa";

const whatsappMessage = encodeURIComponent(
  "¡Hola! Vengo de la página de la Academia.",
);

const sites = [
  { name: "Salón MZ-08, Hotel Hesperia WTC", area: "Naguanagua, Carabobo" },
  {
    name: "Edificio 4, Piso 1, Universidad José Antonio Páez",
    area: "San Diego, Carabobo",
  },
];
---

<section class="w-full border-y-6 border-white">
  <div class="w-full grid md:grid-cols-2">
    <div
      class="flex flex-col w-full bg-gradient-to-b from-gold-soft to-gold-trim gap-6 px-[7.5vw] md:px-10 lg:px-16 py-12 md:py-16 items-start justify-center font-montserrat text-wine-deep"
    >
      <h2 class="text-4xl lg:text-6xl leading-tight text-balance">
        El <b>hogar</b> de los <b>músicos</b> del <b>mañana</b>
      </h2>
      <p class="text-xl lg:text-2xl font-semibold text-balance">
        ¿Quieres formar parte de la academia?
      </p>
      <a
        href="/registro"
        class="flex w-fit items-center justify-center bg-wine hover:bg-wine-deep gap-1 px-8 py-3 rounded-full text-lg lg:text-xl font-montserrat text-white font-medium transition-colors duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wine-deep"
        >Preinscripción <span
          aria-hidden="true"
          class="inline-block align-middle ml-1">➔</span
        ></a
      >
    </div>

    <div
      id="contacto"
      class="flex flex-col w-full bg-gradient-to-b from-wine-deep to-wine border-t-6 md:border-t-0 md:border-l-6 border-white gap-6 px-[7.5vw] md:px-10 lg:px-16 py-12 md:py-16 items-start justify-center font-montserrat text-white"
    >
      <h2 class="text-3xl lg:text-4xl font-bold text-balance">
        ¿Quieres contactarnos?
      </h2>

      <div class="flex flex-col gap-3">
        <a
          href={`https://api.whatsapp.com/send?phone=584143410642&text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-fit items-center gap-2 px-6 py-3 rounded-full font-semibold text-wine-deep bg-gold-trim hover:bg-white transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <FaWhatsapp className="w-5 h-5 shrink-0" aria-hidden="true" />
          Escríbenos por WhatsApp
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
        <a
          href="tel:+584143410642"
          class="inline-flex items-center w-fit min-h-11 font-medium tabular-nums underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          +58 414 341 0642
        </a>
      </div>

      <span aria-hidden="true" class="block w-12 h-0.5 bg-gold-trim"></span>

      <div class="grid lg:grid-cols-2 gap-5">
        {
          sites.map(({ name, area }) => (
            <address class="not-italic text-sm leading-relaxed text-pretty">
              <b>{name}</b>
              <br />
              {area}
            </address>
          ))
        }
      </div>
    </div>
  </div>
</section>
