---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import UpdateStudentPageContent from "../../components/forms/update-student-form/UpdateStudentPageContent";
---

<Layout title="Actualizar Datos | PFM">
   <div class="w-full min-h-screen bg-white pt-24 pb-12">
      <div class="container mx-auto px-4">
         <div class="max-w-4xl mx-auto">
            <h1
               class="text-3xl font-bold text-[#C19310] font-montserrat mb-2 text-center"
            >
               Actualización de Datos
            </h1>
            <p class="text-gray-600 text-center mb-8 font-montserrat">
               Es necesario que actualice su información para continuar
               utilizando la plataforma.
            </p>

            <UpdateStudentPageContent client:only="react" />
         </div>
      </div>
   </div>
</Layout>
