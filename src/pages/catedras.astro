---
import Layout from "../layouts/Layout.astro";
import Header from "@components/site-header.astro";
import PageBand from "@components/sections/page-band.astro";
import PageClose from "@components/sections/page-close.astro";
import Footer from "@components/sections/footer.astro";

import orquesta1 from "@assets/gallery/orquesta1.JPG";
import masterclass from "@assets/gallery/masterclass_violin1.JPG";
import coro0 from "@assets/gallery/coro0.JPG";

interface Catedra {
	title: string;
	description: string;
	items?: string[];
	subcategories?: { category: string; items: string[] }[];
}

const catedras: Catedra[] = [
	{
		title: "Cátedras Teóricas",
		description:
			"Base conceptual para desarrollar lectura, audición, comprensión musical y fundamentos técnicos.",
		items: [
			"Iniciación Musical",
			"Lenguaje Musical",
			"Armonía",
			"Contrapunto",
			"Historia de la Música",
			"Estética",
		],
	},
	{
		title: "Cátedras Prácticas",
		description:
			"Formación instrumental y vocal con acompañamiento docente y trabajo individual o por ensambles.",
		subcategories: [
			{
				category: "Cuerdas Frotadas",
				items: ["Violín", "Viola", "Violoncello", "Contrabajo"],
			},
			{
				category: "Cuerdas Pulsadas",
				items: ["Guitarra", "Cuatro Venezolano", "Mandolina"],
			},
			{
				category: "Vientos Madera",
				items: ["Flauta", "Clarinete", "Fagot", "Oboe", "Saxofón"],
			},
			{
				category: "Vientos Metales",
				items: ["Trompeta", "Trombón", "Tuba", "Corno Francés"],
			},
			{
				category: "Otros",
				items: ["Piano", "Percusión"],
			},
			{
				category: "Voz",
				items: ["Técnica Vocal"],
			},
		],
	},
	{
		title: "Prácticas Grupales",
		description:
			"Espacios de integración para aplicar lo aprendido en ensayos colectivos y repertorio de conjunto.",
		items: [
			"Práctica Coral",
			"Joven Orquesta",
			"Orquesta Académica",
			"Música Venezolana",
			"Música de Cámara",
		],
	},
	{
		title: "Electivas",
		description:
			"Complementos formativos para ampliar recursos interpretativos, creativos y de apoyo musical.",
		items: ["Producción Musical", "Dirección Musical"],
	},
];
---

<Layout
	title="Cátedras"
	description="Programa académico: cátedras teóricas y prácticas, prácticas grupales y electivas de la Academia Internacional de Música Maestro José Calabrese."
>
	<Header />

	<main id="contenido">
		<PageBand
			title="Cátedras"
			photos={[
				{ src: masterclass, alt: "Clase de violín" },
				{ src: coro0, alt: "Ensayo de coro" },
				{ src: orquesta1, alt: "Práctica orquestal" },
			]}
		/>

		<div class="flex flex-col w-[85vw] mx-auto py-6 md:py-10 divide-y divide-gray-200 font-montserrat text-gray-800">
			{
				catedras.map(({ title, description, items, subcategories }) => (
					<section class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-6 lg:gap-12 py-10 md:py-12">
						<div class="flex flex-col gap-3">
							<h2 class="text-2xl md:text-3xl font-bold leading-tight text-wine text-balance">
								{title}
							</h2>
							<p class="text-base font-light italic leading-relaxed text-pretty max-w-[45ch]">
								{description}
							</p>
						</div>

						{subcategories ? (
							<div class="grid grid-cols-2 xl:grid-cols-3 gap-x-6 gap-y-8 lg:pt-1.5">
								{subcategories.map(({ category, items }) => (
									<div class="flex flex-col gap-2">
										<h3 class="text-base md:text-lg font-semibold leading-tight text-wine">
											{category}
										</h3>
										<ul class="flex flex-col gap-1 text-base leading-relaxed">
											{items.map((item) => <li>{item}</li>)}
										</ul>
									</div>
								))}
							</div>
						) : (
							<ul class="grid grid-cols-2 xl:grid-cols-3 gap-x-6 gap-y-2 text-base leading-relaxed self-start lg:pt-1.5">
								{items?.map((item) => <li>{item}</li>)}
							</ul>
						)}
					</section>
				))
			}
		</div>

		<PageClose />
	</main>

	<Footer />
</Layout>
