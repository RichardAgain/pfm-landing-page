---
import Layout from "../layouts/Layout.astro";
import HeroSection from "@components/hero-section.astro";
import AboutUs from "@components/about.astro";
import ImageGridHistory from "@components/grids/image-grid-history.astro"
import History from "@components/history.astro";
import UpcomingEvents from "@components/events/upcoming-events";
import Allies from "@components/allies.astro";
import Contact from "@components/sections/contact.astro"
import Footer from "@components/sections/footer.astro";
---

<Layout>
	<HeroSection />
	<AboutUs />
  <ImageGridHistory />
	<History />
  <UpcomingEvents client:visible />
  <Allies />
  <Contact />
	<Footer />
</Layout>
